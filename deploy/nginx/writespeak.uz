# --- writespeak.uz - the old domain of the Bandzilla IELTS bot (/opt/writespeak, docker compose).
# Everything moved to bandzilla.uz on 2026-10-17 (deploy/nginx/bandzilla.uz); every
# path here 301s to the same path there, so old links keep working:
#     https://writespeak.uz/*, https://www.writespeak.uz/*  -> https://bandzilla.uz/*
#                                    (/cabinet/ sign-in links included)
#     https://admin.writespeak.uz/*  -> https://admin.bandzilla.uz/*
#     http://*                       -> the same, via https
#
# TLS: Let's Encrypt cert "writespeak.uz" covering all three names, issued with
# `certbot --nginx` and auto-renewed by certbot's timer - kept while the domain
# is paid, so the https redirects keep working. Server copy:
# /etc/nginx/sites-available/writespeak.uz (symlinked into sites-enabled).

# The old site address: every path to the same path on bandzilla.uz
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name writespeak.uz www.writespeak.uz;

    ssl_certificate /etc/letsencrypt/live/writespeak.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/writespeak.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://bandzilla.uz$request_uri;
}

# The old admin panel address
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.writespeak.uz;

    ssl_certificate /etc/letsencrypt/live/writespeak.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/writespeak.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://admin.bandzilla.uz$request_uri;
}

# Plain http. The redirect sits inside `location /` so certbot's renewal can
# still answer its /.well-known/acme-challenge/ requests here.
server {
    listen 80;
    listen [::]:80;
    server_name writespeak.uz www.writespeak.uz;

    location / {
        return 301 https://bandzilla.uz$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.writespeak.uz;

    location / {
        return 301 https://admin.bandzilla.uz$request_uri;
    }
}
