# --- bandzilla.uz - the Bandzilla IELTS bot's site (/opt/writespeak, docker compose).
#     https://bandzilla.uz           -> landing page (static: /opt/writespeak/landing)
#     https://bandzilla.uz/cabinet/  -> teachers' web cabinet (admin_web container, /cabinet routes only)
#     https://www.bandzilla.uz       -> 301 to https://bandzilla.uz (one canonical address)
#     http://*                       -> 301 to the https address
#
# The site moved here from writespeak.uz on 2026-10-17; writespeak.uz now
# 301s every path here, and the admin panel stays on admin.writespeak.uz for
# now (deploy/nginx/writespeak.uz).
#
# TLS: Let's Encrypt cert "bandzilla.uz" (bandzilla.uz + www), issued with
# `certbot certonly --nginx --cert-name bandzilla.uz -d bandzilla.uz -d www.bandzilla.uz`
# against the port-80 server below and auto-renewed by certbot's timer. Server
# copy: /etc/nginx/sites-available/bandzilla.uz (symlinked into sites-enabled).
#
# Security headers are set per server; locations only use `expires` (an
# add_header inside a location would silently drop the server-level ones).

# Landing page
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name bandzilla.uz;

    ssl_certificate /etc/letsencrypt/live/bandzilla.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bandzilla.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root /opt/writespeak/landing;
    index index.html;
    gzip_types image/svg+xml;

    location / {
        try_files $uri $uri/ =404;
    }
    # The page itself is always revalidated so copy/price changes show at once.
    location = /index.html {
        expires -1;
    }
    location ~* \.(png|svg|ico)$ {
        expires 7d;
    }
    # Teachers' web cabinet: only /cabinet/ of the admin_web app (webapp/cabinet.py),
    # signed in from the bot - the admin panel itself stays on admin.writespeak.uz.
    location = /cabinet {
        return 301 /cabinet/;
    }
    location ^~ /cabinet/ {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.bandzilla.uz;

    ssl_certificate /etc/letsencrypt/live/bandzilla.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bandzilla.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://bandzilla.uz$request_uri;
}

# Plain http -> https. The redirect sits inside `location /` so certbot's
# issuing and renewal can still answer /.well-known/acme-challenge/ here.
server {
    listen 80;
    listen [::]:80;
    server_name bandzilla.uz www.bandzilla.uz;

    location / {
        return 301 https://bandzilla.uz$request_uri;
    }
}
