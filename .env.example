# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated list of admin Telegram user IDs (at least one required)
ADMIN_TELEGRAM_IDS=123456789
# No leading @ - used to build referral links (bot/handlers/referral.py)
TELEGRAM_BOT_USERNAME=writespeak_bot

# --- OpenAI ---
# Verified against a live key on 2026-08-28 - see bot/config.py's comment
# before changing these (gpt-4o-audio-preview is fully retired).
OPENAI_API_KEY=sk-...
OPENAI_MODEL_GRADING=gpt-5
OPENAI_MODEL_VISION=gpt-5
OPENAI_MODEL_AUDIO=gpt-audio-1.5
OPENAI_MODEL_TRANSCRIBE=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database ---
# Used by the bot container (docker service name "db")
DATABASE_URL=postgresql+asyncpg://ielts:ielts@db:5432/ielts_bot
# Used by alembic / scripts run on the host (localhost, mapped port)
DATABASE_URL_SYNC=postgresql+psycopg://ielts:ielts@localhost:5433/ielts_bot
POSTGRES_USER=ielts
POSTGRES_PASSWORD=ielts
POSTGRES_DB=ielts_bot

# --- Redis (FSM storage) ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
FILE_STORAGE_PATH=/data/storage
BOOKS_PATH=/data/books

# --- Limits & payments ---
# Free Writing+Speaking checks per user per rolling 24h (combined pool).
FREE_DAILY_LIMIT=2
# Price in so'm for one check beyond the free daily quota.
PRICE_PER_CHECK=5000
# Card shown to students for the manual top-up flow (bot/handlers/payments.py).
PAYMENT_CARD_NUMBER=0000 0000 0000 0000
PAYMENT_CARD_HOLDER=F.I.Sh.
# Monthly unlimited-checks subscription price, in so'm.
SUBSCRIPTION_PRICE_MONTHLY=99000

# --- Web admin panel (webapp/main.py, served by the `admin_web` service) ---
# Served at https://admin.writespeak.uz through the host's nginx (see
# docker-compose.yml's admin_web comment). Use a real, strong password.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me
# Random secret used to sign the login session cookie - generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SESSION_SECRET=change-me-too
# true in production (HTTPS): the login cookie is never sent over plain http.
# Leave false for a local http:// run.
WEB_COOKIE_SECURE=false
