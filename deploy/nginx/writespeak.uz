# --- writespeak.uz - the old domain of the Bandzilla IELTS bot (/opt/writespeak, docker compose).
#     https://writespeak.uz/*       -> 301 to https://bandzilla.uz/* (the site moved there on 2026-10-17;
#                                      old links, /cabinet/ sign-in links included, keep working)
#     https://www.writespeak.uz/*   -> the same
#     https://admin.writespeak.uz   -> web admin panel (admin_web container, 127.0.0.1:8088) - stays here for now
#     http://*                      -> 301 to the https address
#
# The site itself: deploy/nginx/bandzilla.uz.
#
# TLS: Let's Encrypt cert "writespeak.uz" covering all three names, issued with
# `certbot --nginx` and auto-renewed by certbot's timer. Server copy:
# /etc/nginx/sites-available/writespeak.uz (symlinked into sites-enabled).
#
# Security headers are set per server; locations only use `expires` (an
# add_header inside a location would silently drop the server-level ones).

# The old site address: every path to the same path on bandzilla.uz
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name writespeak.uz www.writespeak.uz;

    ssl_certificate /etc/letsencrypt/live/writespeak.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/writespeak.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://bandzilla.uz$request_uri;
}

# Web admin panel
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name admin.writespeak.uz;

    ssl_certificate /etc/letsencrypt/live/writespeak.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/writespeak.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # Practice question images (the webapp accepts up to 10 MB).
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        # Overwritten, not appended: the webapp's login brute-force guard keys on it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Plain http -> https. The redirect sits inside `location /` so certbot's
# renewal can still answer its /.well-known/acme-challenge/ requests here.
server {
    listen 80;
    listen [::]:80;
    server_name writespeak.uz www.writespeak.uz;

    location / {
        return 301 https://bandzilla.uz$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.writespeak.uz;

    location / {
        return 301 https://admin.writespeak.uz$request_uri;
    }
}
