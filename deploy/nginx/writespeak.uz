# --- writespeak.uz - WriteSpeak IELTS bot (/opt/writespeak, docker compose).
#     writespeak.uz / www   -> landing sahifa (statik: /opt/writespeak/landing).
#     admin.writespeak.uz   -> web admin panel (admin_web container, 127.0.0.1:8088).
#
# Server copy: /etc/nginx/sites-available/writespeak.uz (symlinked into
# sites-enabled). This is the pre-TLS version; `certbot --nginx` adds the
# 443/redirect blocks to the server copy, so re-run certbot after replacing it.
server {
    server_name writespeak.uz www.writespeak.uz;

    root /opt/writespeak/landing;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # Always revalidate the page itself so copy/price changes show up at once.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location ~* \.(png|svg|ico)$ {
        add_header Cache-Control "public, max-age=604800";
    }

    listen 80;
    listen [::]:80;
}

server {
    server_name admin.writespeak.uz;

    # Practice savol rasmlari (webapp 10 MB gacha qabul qiladi).
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        # Overwritten, not appended: the webapp's login brute-force guard keys on it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 80;
    listen [::]:80;
}
